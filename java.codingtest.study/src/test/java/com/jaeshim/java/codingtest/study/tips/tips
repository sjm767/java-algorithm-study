//최대공약수 구하기 (유클리드 호제법)
GCD(a,b) -> GCD(b, a%b) -> b가 0이 되는 순간 답은 a임.
public static int gcd(int a, int b) {
    if (b == 0) return a;
    return gcd(b, a % b);
}
